# Office rendering tool only, separate from the application's stack and demo.
FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libreoffice-writer python3-uno fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
ENV SAL_USE_VCLPLUGIN=svp
