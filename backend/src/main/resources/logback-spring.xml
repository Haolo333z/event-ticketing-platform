<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="CONSOLE_LOG_STRUCTURED_FORMAT" value="logstash"/>
    <include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>
    <!-- Config documents can contain secrets. Never dump them, even under parent DEBUG. -->
    <logger name="org.springframework.boot.env.OriginTrackedYamlLoader" level="OFF"/>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
