# Local placeholders only. Copy to .env; never commit real credentials.
SPRING_PROFILES_ACTIVE=local
POSTGRES_DB=ticketing_demo
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
VITE_API_BASE_URL=http://127.0.0.1:8080
# Active booking policy (T3); pool timeout is 2000ms in application.yml.
BOOKING_HOLD_TTL_SECONDS=600
BOOKING_MAX_QUANTITY=6
BOOKING_LOCK_TIMEOUT_MS=1500
BOOKING_STATEMENT_TIMEOUT_MS=5000
BOOKING_ATTEMPT_TIMEOUT_MS=5000
BOOKING_TOTAL_TIMEOUT_MS=10000
# Active expiry worker. Controlled tests force scheduling off; live expiry tests force it on.
EXPIRY_ENABLED=true
EXPIRY_INTERVAL_SECONDS=5
EXPIRY_BATCH_SIZE=50
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
